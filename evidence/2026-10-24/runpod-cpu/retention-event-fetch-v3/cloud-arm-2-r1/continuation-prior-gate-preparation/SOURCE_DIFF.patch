+def blob_sha1(path):
+    h = hashlib.sha1()
+    h.update(b'blob ' + str(path.stat().st_size).encode() + b'\x00')
+    with path.open('rb') as source:
+        for block in iter(lambda: source.read(1024**2), b''):
+            h.update(block)
+    return h.hexdigest()
