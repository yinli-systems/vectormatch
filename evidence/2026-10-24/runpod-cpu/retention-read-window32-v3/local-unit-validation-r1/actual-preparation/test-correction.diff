+    private static void failReadEvidenceAt(RetentionBatchMaintenanceV3 coordinator,String fieldName,int selected)throws Exception{
+        Field field=RetentionBatchMaintenanceV3.class.getDeclaredField(fieldName);field.setAccessible(true);var original=(DataOutputStream)field.get(coordinator);
+        field.set(coordinator,new DataOutputStream(new FilterOutputStream(original){
+            int readIndex;final ByteArrayOutputStream line=new ByteArrayOutputStream();
+            @Override public void write(byte[] b,int off,int length)throws IOException{
+                if(fieldName.equals("timings")){for(int i=off;i<off+length;i++)write(b[i]);return;}
+                boolean read=false;
+                try{if(fieldName.equals("requests"))read=RetentionWireV3.decode(Arrays.copyOfRange(b,off,off+length)).operation() instanceof ArchiveChunk;
+                    else read=RetentionReplyV3.decode(Arrays.copyOfRange(b,off,off+length)).payload() instanceof Chunk;
+                }catch(IllegalArgumentException ignored){}
+                if(read&&readIndex++==selected)throw new IOException("injected read evidence failure index="+selected+" sink="+fieldName);
+                out.write(b,off,length);
+            }
+            @Override public void write(int value)throws IOException{
+                if(fieldName.equals("timings")){
+                    if((value&255)=='\n'){
+                        String row=line.toString(java.nio.charset.StandardCharsets.US_ASCII);line.reset();
+                        if(row.contains(",ArchiveChunk,")&&readIndex++==selected)throw new IOException("injected timing evidence failure index="+selected);
+                    }else line.write(value);
+                }
+                out.write(value);
+            }
+        }));
+    }
