+    static Connection openReadOnlyConnection(ConnectionOpener opener, String password) throws SQLException {
+        Connection c = opener.open(URL, connectionProperties(password));
+        try {
+            c.setReadOnly(true);
+            c.setTransactionIsolation(Connection.TRANSACTION_REPEATABLE_READ);
+            c.setAutoCommit(false);
+            return c;
+        } catch (SQLException | RuntimeException failure) {
+            try { c.close(); } catch (SQLException closing) { failure.addSuppressed(closing); }
+            throw failure;
+        }
+    }
