{
  "name": "vectormatch-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src package.json tsconfig.json vite.config.ts index.html",
    "format:check": "prettier --check src package.json tsconfig.json vite.config.ts index.html"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "3.5.3",
    "typescript": "~5.7.3",
    "vite": "^6.3.5"
  }
}
